# Salin ke .env (tidak di-commit). Kunci hanya tersimpan di PC ini.
OPENAI_API_KEY=
# Opsional: model default untuk agent ber-otak OpenAI yang tidak menentukan model sendiri.
OPENAI_MODEL=gpt-6-astra
# Untuk agent ber-otak Claude: API key dari console Anthropic milik kamu.
ANTHROPIC_API_KEY=
# Opsional: model default untuk agent ber-otak Claude yang tidak menentukan model sendiri.
ANTHROPIC_MODEL=claude-opus-5-5
# Video (dirender di PC dengan FFmpeg). Tanpa kunci: suara simulasi (diam) dan latar warna.
ELEVENLABS_API_KEY=
# Opsional: suara dan model ElevenLabs.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2
# Footage gratis dari Pexels (buat kunci di pexels.com/api).
PEXELS_API_KEY=
# Gambar AI per adegan (pilih "Visual video" di pengaturan channel). fal: kunci dari fal.ai.
FAL_KEY=
# Opsional: model gambar. Default fal-ai/flux/schnell dan gpt-image-2 (kualitas medium).
FAL_IMAGE_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=
# Opsional: folder hasil video (default: Videos/Kantoraiku di folder user) dan ukuran (default 1080x1920).
KANTORAIKU_VIDEO_DIR=
KANTORAIKU_VIDEO_SIZE=
# Opsional: alamat server Kantoraiku untuk perintah pair.
KANTORAIKU_SERVER=http://localhost:3000
