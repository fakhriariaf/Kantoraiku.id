{
  "name": "@kantoraiku/connector",
  "productName": "Kantoraiku",
  "version": "0.2.0",
  "private": true,
  "description": "Konektor Kantoraiku untuk Windows: menjalankan agent kantor di PC kamu.",
  "author": "Kantoraiku",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
