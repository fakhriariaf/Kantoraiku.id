    "release": "node build.mjs && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@kantoraiku/runner": "workspace:*",
    "@kantoraiku/shared": "workspace:*",
    "@types/node": "^20.19.43",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "esbuild": "0.28.2",
    "ffmpeg-static": "^5.3.0",
    "typescript": "5.9.3"
  }
}
