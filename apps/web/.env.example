# Salin ke .env.local (tidak di-commit). Untuk Supabase lokal, jalankan `pnpm env:local`
# setelah `pnpm db:start`: skrip itu mengisi 4 nilai Supabase di bawah dari `supabase status`.
# Untuk Supabase cloud: isi sendiri dari Project Settings > API dan Database (pooler, mode transaksi).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Bisnis (nilai di bawah adalah DUMMY; ganti sebelum production)
APP_DOMAIN=localhost:3000
# Dev: 1 = alamat kantor memakai {slug}.localhost:3000 (production selalu memakai subdomain).
OFFICE_SUBDOMAINS=
PUBLIC_DOMAIN=kantoraiku.id
PRICE_LIFETIME_IDR=299000
MANUAL_BANK_NAME=BANK DUMMY
MANUAL_BANK_ACCOUNT=0000000000
MANUAL_BANK_HOLDER=NAMA PEMILIK (DUMMY)
ADMIN_WHATSAPP=6280000000000
MANUAL_PAYMENT_HOURS=72
# Kontak dan identitas di footer + halaman legal (kotak surat dibuat sendiri)
SUPPORT_EMAIL=support@kantoraiku.id
LEGAL_ENTITY=

# WhatsApp Cloud API (app Meta milik Kantoraiku): App Dashboard > App settings > Basic (app secret),
# token verifikasi webhook bebas dipilih, versi Graph API yang dipakai.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0

# Seed dev (pnpm seed): admin dibuat dengan password acak bila DEV_ADMIN_PASSWORD kosong;
# kredensial ditulis ke apps/web/.data/dev-credentials.txt (tidak di-commit).
DEV_ADMIN_EMAIL=admin@kantoraiku.test
DEV_ADMIN_PASSWORD=
